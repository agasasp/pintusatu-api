{
  "info": {
    "_postman_id": "7a941589-b003-4c91-913b-85ef1c8c12a4",
    "name": "PintuSatu API - Auth Module",
    "description": "Collection untuk modul Autentikasi & Staf PintuSatu SaaS REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register Owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi.santoso@gmail.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"081234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Registrasi akun Owner kost baru. Otomatis mendapatkan subscription starter."
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.success && response.data && response.data.token) {",
              "    pm.collectionVariables.set('token', response.data.token);",
              "    pm.environment.set('token', response.data.token);",
              "    console.log('Token automatically saved to environment and collection variables:', response.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"budi.santoso@gmail.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login user (Owner, Penjaga, Superadmin). Script test otomatis menyimpan token JWT ke variabel {{token}}."
      }
    },
    {
      "name": "3. Get My Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Mengambil detail profil akun yang sedang login berdasarkan Bearer token."
      }
    },
    {
      "name": "4. Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Budi Santoso S.Kom\",\n  \"phone\": \"081298765432\",\n  \"avatarUrl\": \"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "profile"]
        },
        "description": "Memperbarui nama, nomor telepon, atau URL avatar foto profil."
      }
    },
    {
      "name": "5. Change Password",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"BaruPassword123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "password"]
        },
        "description": "Mengganti password akun. Membutuhkan verifikasi password lama."
      }
    },
    {
      "name": "6. Create Staff (Penjaga Kost)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Joko Penjaga\",\n  \"email\": \"joko.penjaga@gmail.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"085712345678\",\n  \"branchIds\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/staff",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "staff"]
        },
        "description": "Owner membuat akun baru dengan role 'penjaga'. Opsional: langsung pasang branchIds (UUID cabang)."
      }
    },
    {
      "name": "7. List Staff",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/staff",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "staff"]
        },
        "description": "Mengambil daftar seluruh staf / penjaga kost yang berada di bawah owner yang sedang login."
      }
    }
  ]
}
